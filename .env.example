NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AWS_REGION is reserved by Amplify, which sets it at runtime. Set it
# locally in .env.local only (us-east-2, same region as the bucket) -
# never define it in Amplify environment variables.
AWS_REGION=
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=
